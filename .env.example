# ===== office-agent 配置示例：复制为 .env 后按需修改 =====
# 字段名即环境变量名；唯一出处 packages/core/office_agent_core/settings.py

# JWT 签名密钥（生产必须显式设置且不少于 32 字符）
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=28800
# 注意：改 PASSWORD_HASH_ITERATIONS 会让存量口令全部验不过，必须同步重刷
PASSWORD_HASH_ITERATIONS=100000

# 本仓库自有 SQLite 库（数据不出域：自有库与外部系统零数据库连接）
DATABASE_URL=sqlite+aiosqlite:///./office-agent.db

# 允许跨域的前端来源（JSON 数组）：本地 npm run dev 是 5173；生产走反向代理同源可留空
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# 演示种子账号（生产：ENV=prod + SEED_ON_START=false，缺一即启动报错）
ENV=dev
SEED_ON_START=true
SEED_TENANT=demo-tenant
SEED_USERNAME=admin
SEED_PASSWORD=admin123
SEED_ROLES=*

# 工具执行三维度（超时 30s / 幂等重试 3 次 / 熔断阈值与冷却）
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_TOOL_MAX_RETRIES=3
AGENT_TOOL_CIRCUIT_THRESHOLD=3
AGENT_TOOL_CIRCUIT_COOLDOWN_SECONDS=60
AGENT_TOOL_RETRY_BACKOFF_SECONDS=0.2

# 跨系统联动：provider_id → 外部系统的工具出口（地址与凭据只在此处，绝不入库入码）。
# 对端把本内核当普通登录用户对待，不新造信任体系，故 token 是服务账号的登录令牌：
#   1) 在外部系统建服务账号（角色含读工具 Scope + agent:gateway）
#   2) 用其账号登录换取 token，填到下面（过期后重换）
# 未配置该键时插件不注册远程工具（清单里自然缺席），绝不静默降级成假数据。
LINKAGE_PROVIDERS={"ecommerce":{"base_url":"http://127.0.0.1:8000","token":""}}
# 出站标识头 X-Office-Agent 的前缀（外部系统据此识别调用方做治理与限流区分）
LINKAGE_CLIENT_NAME=office-agent

# ===== M3：标准 MCP 协议桥（可选；装了 office-agent-mcp-bridge 才生效） =====
# 同一份 LINKAGE_PROVIDERS 里用 transport 分流：默认 "http"（M2 自定义网关）由内核认领，
# "mcp" 由 mcp-bridge 认领——对端从自定义网关换成标准 MCP Server 时，只改这一处配置，
# 工具清单（tools/list 自动发现）、Scope、审批、审计、溯源全部复用，业务代码一行不改。
# path 请显式给对端 MCP 端点（标准形态多为 /mcp）；不配则按内核网关默认路径试并告警。
# MCP 工具按注解映射治理属性：readOnlyHint=true → 只读免审批；注解缺失/非只读 → 恒送审。
# LINKAGE_PROVIDERS={"ecommerce":{"base_url":"http://127.0.0.1:8000","token":""},"partner-mcp":{"base_url":"http://127.0.0.1:9000","path":"/mcp","transport":"mcp","token":""}}

# ===== IM 审批通知出站（可选；留空即整能力缺席，不发任何网络请求） =====
# 挂在「审批落单」与「审批超时扫描命中新单」两处；推送失败/超时只降级记录，绝不阻断审批流。
# 消息面向群而非个人：只推「有单要处理」类事件，不含业务明细。
# 类型：generic（默认，通用 JSON）/ feishu / dingtalk / wecom
# IM_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# IM_WEBHOOK_TYPE=feishu
# 飞书/钉钉加签密钥（钉钉无密钥时不加签；generic/wecom 忽略该项）
# IM_WEBHOOK_SECRET=
# IM_WEBHOOK_TIMEOUT_SECONDS=5
# 超时催办聚合上限（一次推送最多列几单，其余折成「另有 X 单」）
# IM_WEBHOOK_MAX_ITEMS=5

# ===== 主动消息推送（站内通知扫描阈值，PRD §2.2 / §5.1） =====
# 审批超时判定阈值（小时）与单轮扫描上限
# APPROVAL_STALE_HOURS=24
# NOTIFICATION_MAX_PER_SCAN=50
# 个人事务提醒口径：业务时区决定「今天/周五」与日程时间基准（Windows 需装 tzdata 包，缺失自动降级 UTC）；
# 到期/会前/项目节点窗口 = 待办截止提前小时 / 会议开始提前小时 / 节点提前天数
# BUSINESS_TIMEZONE=Asia/Shanghai
# TODO_DUE_LOOKAHEAD_HOURS=24
# MEETING_UPCOMING_HOURS=24
# MILESTONE_LOOKAHEAD_DAYS=3

# ===== R1：LLM 函数调用规划器 =====
# AgentSpec.llm 字段值在此处匹配同名 profile；未配置 LLM_PROVIDERS 或 profile 未找到
# → Runner 自动降级到 RulePlanner（若有 rules），否则创建 run 时报中文可操作错误。
# OpenAI 兼容接口示例（gpt-4o-mini 或其他 Chat Completions 兼容模型）：
# LLM_PROVIDERS={"default":{"base_url":"https://api.openai.com/v1","model":"gpt-4o-mini","api_key":"sk-xxx"}}
# Ollama 本地示例（无需 api_key）：
# 本键由 planner 直接读 os.environ，写在 .env 里需启动入口载入进程环境——
# `python -m office_agent_server` 已在 main() 里 load_dotenv(override=False)，改完 .env 重启即生效。
LLM_PROVIDERS={"default":{"base_url":"http://127.0.0.1:11434/v1","model":"qwen3:8b","api_key":""}}

# ===== 本地向量检索（知识库语义检索，kb.ask 升级通道） =====
# base_url 与 model 任一留空 → kb.ask 走字符 bigram 检索（默认口径，零网络）。
# 两者都配 → 按段落取向量做余弦排序，改说法也能命中（如「出差花销找谁签字」→ 差旅标准）。
# 契约与 LLM_PROVIDERS 一致：OpenAI 兼容 /embeddings，base_url 以 /v1 结尾，Ollama 时 api_key 可空。
# 调用失败（对端离线/超时/响应非法）只回退字符检索并在 retrieval_mode/retrieval_fallback_reason 标注，绝不 500。
# 注意：本键由工具包直接读 Settings，不必走 os.environ，写在 .env 里改完重启即生效。
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT_SECONDS=30
# 余弦相似度门槛：低于它的段落不算命中（余弦对任意文本都给分，不过滤会把无命中伪装成有命中）。
# 实测（qwen3-embedding:0.6b + 内置 4 条制度）相关/不相关两簇有重叠，0.35 偏召回；换模型/语料须重新校准。
# EMBEDDING_MIN_SCORE=0.35

# 可观测（内存计数 + JSONL 落盘；接网关后只替换该模块）
OBSERVABILITY_ENABLED=true
OBSERVABILITY_DIR=data/observability

# ===== 单包模式附加键（office_agent/config.py；与本文件上方 packages 侧键共存，互不干扰） =====
# 双账号审批演示：管理员（默认 admin/admin123）+ 复核员；复核员留空 = 单人演示模式，审批闭环走不通正向批准
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=reviewer123